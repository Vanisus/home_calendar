POSTGRES_USER=homeboard
POSTGRES_PASSWORD=password
POSTGRES_DB=homeboard

HOMEBOARD_TIMEZONE=Europe/Saratov
HOMEBOARD_LOG_LEVEL=INFO
HOMEBOARD_ADMIN_TOKEN=change-me-to-a-long-random-string
HOMEBOARD_CALENDAR_REFRESH_SECONDS=300
